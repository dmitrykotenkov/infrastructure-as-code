#
# Managed by Ansible - auditd configuration
# Based on CIS Benchmark recommendations
#

# Log file location
log_file = /var/log/audit/audit.log
log_format = ENRICHED

# Log file settings
max_log_file = {{ iac__bootstrap__auditd__max_log_file }}
num_logs = {{ iac__bootstrap__auditd__num_logs }}
max_log_file_action = {{ iac__bootstrap__auditd__max_log_file_action }}

# Priority boost for auditd
priority_boost = 4

# Flush settings (NONE, INCREMENTAL, INCREMENTAL_ASYNC, DATA, SYNC)
flush = INCREMENTAL_ASYNC
freq = 50

# Dispatcher program
disp_qos = lossy
dispatcher = /sbin/audispd

# Network settings (disabled by default)
write_logs = yes
log_group = adm

# Name format (NONE, HOSTNAME, FQD, NUMERIC, USER)
name_format = HOSTNAME

# Space settings
space_left = 75
space_left_action = {{ iac__bootstrap__auditd__space_left_action }}
admin_space_left = 50
admin_space_left_action = {{ iac__bootstrap__auditd__admin_space_left_action }}

# Disk settings
disk_full_action = {{ iac__bootstrap__auditd__disk_full_action }}
disk_error_action = {{ iac__bootstrap__auditd__disk_error_action }}

# Overflow action
overflow_action = SYSLOG

# Use libcap-ng
use_libwrap = yes
tcp_listen_queue = 5
tcp_max_per_addr = 1
tcp_client_max_idle = 0

# End of network listener options
enable_krb5 = no
krb5_principal = auditd
