# Managed by Ansible - PAM Hardening
# /etc/pam.d/common-password - password-related modules

# Password quality checking (pam_pwquality)
password    requisite     pam_pwquality.so retry={{ iac__bootstrap__pam_hardening__retry }}

# Password history (pam_pwhistory) - prevent password reuse
password    required      pam_pwhistory.so remember={{ iac__bootstrap__pam_hardening__remember }} use_authtok

# Standard Unix authentication (pam_unix)
password    [success=1 default=ignore]    pam_unix.so obscure use_authtok try_first_pass yescrypt

# Fallback for local users
password    requisite     pam_deny.so

# Prime the stack with a positive return
password    required      pam_permit.so
